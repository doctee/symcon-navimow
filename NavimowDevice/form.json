{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "DeviceId",
      "caption": "Device ID"
    },
    {
      "type": "ValidationTextBox",
      "name": "DisplayName",
      "caption": "Display Name"
    },
    {
      "type": "CheckBox",
      "name": "DebugPayloads",
      "caption": "Enable debug payload variable"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Refresh Status",
      "onClick": "echo NAVDV_RefreshStatus($id);"
    },
    {
      "type": "Button",
      "caption": "Dock",
      "confirm": "Send the mower to the dock?",
      "onClick": "echo NAVDV_Dock($id);"
    },
    {
      "type": "Label",
      "caption": "Dock is the only enabled mower command."
    }
  ]
}
