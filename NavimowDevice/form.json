{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "DeviceId",
      "caption": "Device ID"
    },
    {
      "type": "ValidationTextBox",
      "name": "DisplayName",
      "caption": "Display Name"
    },
    {
      "type": "CheckBox",
      "name": "DebugPayloads",
      "caption": "Enable debug payload variable"
    },
    {
      "type": "CheckBox",
      "name": "EnableLocalMap",
      "caption": "Enable local map"
    },
    {
      "type": "CheckBox",
      "name": "EnableZoneStatistics",
      "caption": "Expose revision-bound zone statistics"
    },
    {
      "type": "CheckBox",
      "name": "EnableMowingAnalytics",
      "caption": "Expose retained mowing analytics"
    },
    {
      "type": "ValidationTextBox",
      "name": "AcceptedGeometryKey",
      "caption": "Accepted map revision"
    },
    {
      "type": "ValidationTextBox",
      "name": "AcceptedMapProjection",
      "caption": "Accepted private map package"
    },
    {
      "type": "ValidationTextBox",
      "name": "HiddenZoneSequences",
      "caption": "Hidden zone label sequences"
    },
    {
      "type": "Select",
      "name": "MapTheme",
      "caption": "Map color theme",
      "options": [
        {
          "caption": "Dark",
          "value": "dark"
        },
        {
          "caption": "Light",
          "value": "light"
        }
      ]
    },
    {
      "type": "NumberSpinner",
      "name": "TrackRetentionHours",
      "caption": "Track retention hours",
      "minimum": 1,
      "maximum": 720
    },
    {
      "type": "NumberSpinner",
      "name": "MapRefreshInterval",
      "caption": "Active map refresh interval",
      "suffix": " seconds",
      "minimum": 15,
      "maximum": 900
    },
    {
      "type": "NumberSpinner",
      "name": "MapIdleRefreshInterval",
      "caption": "Idle map refresh interval",
      "suffix": " seconds",
      "minimum": 60,
      "maximum": 3600
    },
    {
      "type": "ValidationTextBox",
      "name": "StatisticsTimeZone",
      "caption": "Statistics time zone"
    },
    {
      "type": "NumberSpinner",
      "name": "MetersPerLocalUnit",
      "caption": "Meters per local coordinate unit",
      "digits": 3,
      "minimum": 0.001,
      "maximum": 1000
    },
    {
      "type": "NumberSpinner",
      "name": "CuttingWidthMeters",
      "caption": "Cutting width for diagnostic coverage",
      "suffix": " m",
      "digits": 2,
      "minimum": 0,
      "maximum": 10
    },
    {
      "type": "NumberSpinner",
      "name": "CoverageCellSizeMeters",
      "caption": "Coverage grid cell size",
      "suffix": " m",
      "digits": 2,
      "minimum": 0.01,
      "maximum": 5
    },
    {
      "type": "NumberSpinner",
      "name": "MowingRecencyWarningDays",
      "caption": "Mowing due after",
      "suffix": " days",
      "minimum": 1,
      "maximum": 365
    },
    {
      "type": "NumberSpinner",
      "name": "MowingRecencyCriticalDays",
      "caption": "Mowing overdue after",
      "suffix": " days",
      "minimum": 2,
      "maximum": 730
    },
    {
      "type": "ValidationTextBox",
      "name": "StatisticsSubareas",
      "caption": "Optional revision-bound statistics subareas"
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Refresh Status",
      "onClick": "echo NAVDV_RefreshStatus($id);"
    },
    {
      "type": "Button",
      "caption": "Refresh Local Map",
      "onClick": "echo NAVDV_RefreshLocalMap($id);"
    },
    {
      "type": "Button",
      "caption": "Pause",
      "confirm": "Pause the currently running mower?",
      "onClick": "echo NAVDV_Pause($id);"
    },
    {
      "type": "Button",
      "caption": "Resume",
      "confirm": "Resume mowing now? The mower may begin moving and cutting immediately.",
      "onClick": "echo NAVDV_Resume($id);"
    },
    {
      "type": "Button",
      "caption": "Dock",
      "confirm": "Send the mower to the dock?",
      "onClick": "echo NAVDV_Dock($id);"
    },
    {
      "type": "Label",
      "caption": "Pause, Resume and Dock are enabled. Stop and Start remain disabled."
    }
  ]
}
